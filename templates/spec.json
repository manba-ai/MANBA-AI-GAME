        "b": {
          "key": "b",
          "label": "Exit from system pages",
          "repeat_ms": 0
        },
        "x": {
          "key": "x",
          "label": "Retry from pause/result",
          "repeat_ms": 0
        },
        "y": {
          "key": "y",
          "label": "Help / title",
          "repeat_ms": 0
        }
